{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "copper",
        "model": {
          "type": "minecraft:model",
          "model": "mchemistry:item/clip_mesh_copper_black"
        }
      },
      {
        "when": "silver",
        "model": {
          "type": "minecraft:model",
          "model": "mchemistry:item/clip_mesh_silver_black"
        }
      },
      {
        "when": "platinum",
        "model": {
          "type": "minecraft:model",
          "model": "mchemistry:item/clip_mesh_silver_black"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "mchemistry:item/clip_mesh_silver_black_clip"
    }
  }
}
